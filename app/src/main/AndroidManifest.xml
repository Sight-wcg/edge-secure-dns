<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 现代 Xposed API（libxposed）：不再使用 xposedmodule / xposedminversion 等 meta-data。
         模块名取 android:label，描述取 android:description；
         入口（java_init.list）、配置（module.prop）、作用域（scope.list）
         位于 src/main/resources/META-INF/xposed/。 -->
    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:label="@string/app_name" />

</manifest>
